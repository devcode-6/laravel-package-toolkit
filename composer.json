{
    "name": "devcode-6/package-toolkit",
    "description": "A reusable Laravel-ready toolkit package",
    "type": "library",

    "require": {
        "php": "^8.1"
    },

    "autoload": {
        "psr-4": {
            "Devcode6\\PackageToolkit\\": "src/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "Devcode6\\PackageToolkit\\Providers\\PackageToolkitServiceProvider"
            ],
            "aliases": {
                "PackageToolkit": "Devcode6\\PackageToolkit\\Facades\\PackageToolkit"
            }
        }
    },

    "minimum-stability": "dev",
    "prefer-stable": true,

    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    }
}